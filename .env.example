# GridSmart Environment Variables

# Database Configuration (Defaults to SQLite for instant local execution)
# To use PostgreSQL, set DATABASE_URL to your postgres connection URI:
DATABASE_URL=sqlite:///./backend/gridsmart.db

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:8000
